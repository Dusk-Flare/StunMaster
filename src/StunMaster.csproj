<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="TargetVariables.props" />
	<Import Project="TargetData.targets" />

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>14</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>../mod/newest/plugins</OutputPath>
    <PathMap>$(MSBuildProjectDirectory)=/$(SolutionName)</PathMap>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="..\lib\*.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="ImprovedInput">
      <HintPath>$(externalLibPath)\ImprovedInput\ImprovedInput.dll</HintPath>
    </Reference>
    <Reference Include="Rain Meadow">
      <HintPath>$(externalLibPath)\RainMeadow\Rain Meadow.dll</HintPath>
    </Reference>
    <Reference Include="SlugBase">
      <HintPath>$(externalLibPath)\SlugBase\SlugBase.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PolySharp" Version="1.16.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

	<PropertyGroup>
		<GUID>com.lanta.stunmaster</GUID>
		<ModName>Stun Master</ModName>
		<StunMasterID>stunmaster</StunMasterID>
		<Version>0.2.0</Version>
	</PropertyGroup>
	
	<Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="Exists('$(RainWorldDir)')">
		<ItemGroup>
			<Assets Include="$(ProjectDir)../assets/**/*.*" />
		</ItemGroup>
		<RemoveDir Directories="$(RainWorldDir)/RainWorld_Data/StreamingAssets/mods/$(ProjectName)" />
		<MakeDir Directories="$(RainWorldDir)/RainWorld_Data/StreamingAssets/mods/$(ProjectName)/plugins" />
		<Copy SourceFiles="@(Assets)" DestinationFiles="$(RainWorldDir)/RainWorld_Data/StreamingAssets/mods/$(ProjectName)/%(RecursiveDir)%(Filename)%(Extension)" />
		<Copy SourceFiles="$(TargetDir)$(ProjectName).dll;$(TargetDir)$(ProjectName).pdb" DestinationFolder="$(RainWorldDir)/RainWorld_Data/StreamingAssets/mods/$(ProjectName)/plugins" />
		<MakeDir Directories="$(TargetDir)_tempZip/$(TargetName)" />
		<Copy SourceFiles="@(Assets)" DestinationFiles="$(TargetDir)_tempZip/$(ProjectName)/%(RecursiveDir)%(Filename)%(Extension)" />
		<Copy SourceFiles="$(TargetDir)$(ProjectName).dll;$(TargetDir)$(ProjectName).pdb" DestinationFolder="$(TargetDir)_tempZip/$(ProjectName)/plugins" />
		<ZipDirectory SourceDirectory="$(TargetDir)_tempZip\" DestinationFile="$(ReleasePath)\$(TargetName).zip" Overwrite="true" />
	</Target>
</Project>
